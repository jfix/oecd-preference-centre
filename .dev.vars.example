# Copy to .dev.vars for local development. Use `wrangler secret put` in production.
SIGNING_SECRET=change-me-to-a-long-random-string
# Leave empty to use the fake Adestra adapter (logs to /dev/adestra instead of calling the API).
ADESTRA_API_KEY=
ADESTRA_BASE_URL=https://app.adestra.com/api/rest/1
ADESTRA_CORE_TABLE_ID=
