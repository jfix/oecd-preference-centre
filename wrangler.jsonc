{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oecd-preference-centre",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/confirm", "/signin", "/unsubscribe", "/dev/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prefs",
      // Replace with the id from `wrangler d1 create prefs` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "http://localhost:8787",
    // Shows the dev mailbox and Adestra sync log. Set to "false" in production.
    "DEV_TOOLS": "true",
    // Comma-separated origins allowed to embed the signup widget.
    "WIDGET_ORIGINS": "http://localhost:8787,https://www.oecd.org"
  },
  // Retries anything the outbox couldn't push to Adestra straight away.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
